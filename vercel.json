{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/seller.html",
      "destination": "/seller",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/content/terms",
      "destination": "/api/content?type=terms"
    },
    {
      "source": "/api/content/terms",
      "destination": "/api/content?type=terms"
    },
    {
      "source": "/api/admin/content/privacy",
      "destination": "/api/content?type=privacy"
    },
    {
      "source": "/api/content/privacy",
      "destination": "/api/content?type=privacy"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/auth/otp/send",
      "destination": "/api/auth-otp?action=send"
    },
    {
      "source": "/api/auth/otp/verify",
      "destination": "/api/auth-otp?action=verify"
    },
    {
      "source": "/api/auth-otp-send",
      "destination": "/api/auth-otp?action=send"
    },
    {
      "source": "/api/auth-otp-verify",
      "destination": "/api/auth-otp?action=verify"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin-login"
    },
    {
      "source": "/api/admin/agreement",
      "destination": "/api/agreement"
    },
    {
      "source": "/api/agreement",
      "destination": "/api/agreement"
    },
    {
      "source": "/api/seller/profile/save",
      "destination": "/api/seller"
    },
    {
      "source": "/api/seller/profile",
      "destination": "/api/seller"
    },
    {
      "source": "/api/seller-profile",
      "destination": "/api/seller"
    },
    {
      "source": "/api/seller-save",
      "destination": "/api/seller"
    },
    {
      "source": "/api/admin/seller/decision",
      "destination": "/api/seller-decision"
    },
    {
      "source": "/api/admin/sellers",
      "destination": "/api/admin-sellers"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/seller",
      "destination": "/seller.html"
    },
    {
      "source": "/partner",
      "destination": "/seller.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
