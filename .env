# Apnazo Backend & Admin Environment Configuration

# Public API & Website Port
PORT=3000

# Dedicated Admin Portal Port (Isolated)
ADMIN_PORT=3001

# Production Base URL
BASE_URL=https://apnazo-backend.onrender.com
API_BASE_URL=https://apnazo-backend.onrender.com

# Admin Credentials
ADMIN_USER=admin@apnazo.com
ADMIN_PASS=ApnazoAdmin@2026

# SMS Gateway Integration (APIHome / apisol)
APIHOME_API_KEY=3864528b7d85d9fed83716fd4a3bff3750151
APIHOME_URL=https://apisol.in/panel/api/bulksms/

# DLT Approved Template Format: Dear Customer Your Login otp is {#var#} Text2
SMS_TEMPLATE=Dear Customer Your Login otp is {otp} Text2

# Optional Fallback OTP for testing / emergency bypass
FALLBACK_OTP=123456

# Environment mode
NODE_ENV=production
